<Page
    x:Class="WINUI_TEST.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WINUI_TEST"
    xmlns:models="using:WINUI_TEST.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <BreadcrumbBar x:Name="ProductBreadcrumb" />

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

        <!-- 30% left: search + totals + scrollable cards -->
        <Grid Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <AutoSuggestBox
                x:Name="ProductSearch"
                PlaceholderText="Buscar producto, categoría o código de barras..."
                QueryIcon="Find"
                TextChanged="ProductSearch_TextChanged" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ProductsCountText" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="TotalValueText" Grid.Column="1" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            </Grid>

            <ListView
                x:Name="ProductsList"
                Grid.Row="2"
                SelectionMode="Single"
                IsItemClickEnabled="False"
                SelectionChanged="ProductsList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Grid DataContext="{TemplateBinding Content}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Target="CardRoot.Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="CardRoot.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="CardRoot.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Target="CardRoot.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOverSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="CardRoot.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PressedSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="CardRoot.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>

                                        <Border
                                            x:Name="CardRoot"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,10,16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Width="56" Height="56" VerticalAlignment="Top">
                                                    <Border
                                                        Width="56"
                                                        Height="56"
                                                        CornerRadius="8">
                                                        <SymbolIcon Symbol="Tag" />
                                                    </Border>
                                                    <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
                                                </Grid>

                                                <Grid Grid.Column="1" RowSpacing="2" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="{Binding ProductName}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />

                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding ProductId}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Category}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{Binding PriceText}" Style="{ThemeResource BodyTextBlockStyle}" />
                                                        <TextBlock Text="{Binding CostText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="3" Text="{Binding CodeBar}" Style="{ThemeResource CaptionTextBlockStyle}" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- 70% right: selected product page -->
        <Border
            Grid.Column="1"
            CornerRadius="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8" MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="Detalle del producto" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <CommandBar
                        DefaultLabelPosition="Right"
                        HorizontalAlignment="Stretch"
                        Background="Transparent">
                        <AppBarButton Icon="Add" Label="Nuevo" Click="NewButton_Click" />
                        <AppBarButton Icon="Edit" Label="Editar" Click="EditButton_Click" />
                        <AppBarButton Icon="Import" Label="Importar" Click="ImportButton_Click" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Icon="Copy" Label="Duplicar producto" Click="DuplicateButton_Click" />
                            <AppBarButton Icon="Delete" Label="Eliminar producto" Click="DeleteButton_Click" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>

                    <Grid Width="120" Height="120" HorizontalAlignment="Left" Margin="0,4,0,8">
                        <Border
                            x:Name="DetailPhotoPlaceholder"
                            CornerRadius="12"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <SymbolIcon Symbol="Camera" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Foto del producto" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Image
                            x:Name="DetailPhotoImage"
                            Stretch="UniformToFill"
                            Visibility="Collapsed" />
                    </Grid>

                    <TextBlock x:Name="DetailPlaceholder" Text="Selecciona un producto de la lista." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <StackPanel x:Name="DetailFields" Visibility="Collapsed" Spacing="8">
                        <TextBox x:Name="DetailIdBox" Header="ID del producto" />
                        <TextBox x:Name="DetailNameBox" Header="Nombre" />
                        <TextBox x:Name="DetailCodeBarBox" Header="Código de barras" />
                        <TextBox x:Name="DetailSkuBox" Header="SKU" />
                        <TextBox x:Name="DetailDescriptionBox" Header="Descripción" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                        <ComboBox x:Name="DetailCategoryBox" Header="Categoría" HorizontalAlignment="Stretch" />
                        <NumberBox x:Name="DetailPriceBox" Header="Precio" SpinButtonPlacementMode="Inline" SmallChange="0.01" LargeChange="1" />
                        <NumberBox x:Name="DetailCostBox" Header="Costo" SpinButtonPlacementMode="Inline" SmallChange="0.01" LargeChange="1" />
                        <TextBox x:Name="DetailUnitBox" Header="Unidad del producto" />
                        <NumberBox x:Name="DetailStockBox" Header="Existencia" SpinButtonPlacementMode="Inline" LargeChange="1" />
                        <ToggleSwitch x:Name="DetailActiveSwitch" Header="Producto activo" OnContent="" OffContent="" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <CheckBox x:Name="DetailSerialCheck" Content="Manejo de Serial" />
                            <CheckBox x:Name="DetailLotCheck" Content="Manejo de Lotes" />
                        </StackPanel>
                        <Button x:Name="SaveButton" Content="Guardar" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SaveButton_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>
    </Grid>
</Page>