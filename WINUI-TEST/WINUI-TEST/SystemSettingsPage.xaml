<Page
    x:Class="WINUI_TEST.SystemSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="4">

                <BreadcrumbBar
                    x:Name="CatalogBreadcrumb"
                    ItemClicked="CatalogBreadcrumb_ItemClicked" />

<InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Success" />

                <TextBlock Text="Configuración del sistema" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Administra los datos maestros: datos de producto, inventario y catálogos."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <AutoSuggestBox
                    x:Name="ConfigSearch"
                    PlaceholderText="Buscar en la configuración (ej. unidad, categoría, almacén...)"
                    QueryIcon="Find"
                    TextChanged="ConfigSearch_TextChanged" />

                <!-- ============ DATOS DE PRODUCTOS ============ -->
                <TextBlock x:Name="DataSectionHeader" Text="Datos de productos" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,2,0,0" />

                <Expander
                    x:Name="UnitsExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Padding="16,6,16,6"
                    Margin="0,2,0,2"
                    Expanding="CatalogExpander_Expanding"
                    Collapsed="CatalogExpander_Collapsed">
                    <Expander.Header>
                        <Grid ColumnSpacing="6" MinHeight="88">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="8">
                                <SymbolIcon Symbol="Calculator" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Unidades de producto" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Administra las unidades de medida usadas por los productos (pieza, caja, kg, rollo...)."
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Padding="4,4,4,8" Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UnitsCountText" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Click="AddUnitButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Add" />
                                    <TextBlock Text="Agregar unidad" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid>
                            <ListView
                                x:Name="UnitsList"
                                MaxHeight="252"
                                SelectionMode="None"
                                IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <SymbolIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Symbol="Calculator" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Abbreviation}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Tag="{Binding}" Click="EditItem_Click" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Editar">
                                                    <SymbolIcon Symbol="Edit" />
                                                </Button>
                                                <Button Tag="{Binding}" Click="DeleteItem_Click" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Eliminar">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="UnitsEmptyText"
                                Text="No hay unidades. Agrega la primera."
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed"
                                Margin="8,8" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander
                    x:Name="CategoryExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Padding="16,6,16,6"
                    Margin="0,2,0,2"
                    Expanding="CatalogExpander_Expanding"
                    Collapsed="CatalogExpander_Collapsed">
                    <Expander.Header>
                        <Grid ColumnSpacing="6" MinHeight="88">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="8">
                                <SymbolIcon Symbol="Filter" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Categorías" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Define las categorías para clasificar los productos del catálogo."
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Padding="4,4,4,8" Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CategoriesCountText" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Click="AddCategoryButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Add" />
                                    <TextBlock Text="Agregar categoría" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid>
                            <ListView
                                x:Name="CategoriesList"
                                MaxHeight="252"
                                SelectionMode="None"
                                IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <SymbolIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Symbol="Filter" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Tag="{Binding}" Click="EditItem_Click" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Editar">
                                                    <SymbolIcon Symbol="Edit" />
                                                </Button>
                                                <Button Tag="{Binding}" Click="DeleteItem_Click" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Eliminar">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="CategoriesEmptyText"
                                Text="No hay categorías. Agrega la primera."
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed"
                                Margin="8,8" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ============ INVENTARIO ============ -->
                <TextBlock x:Name="InventorySectionHeader" Text="Inventario" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,2,0,0" />

                <Expander
                    x:Name="WarehouseExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Padding="16,6,16,6"
Margin="0,2,0,10"
                    Expanding="CatalogExpander_Expanding"
                    Collapsed="CatalogExpander_Collapsed">
                    <Expander.Header>
                        <Grid ColumnSpacing="6" MinHeight="88">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="8">
                                <SymbolIcon Symbol="Folder" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Almacenes" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Gestiona los almacenes o puntos de stock de la compañía y su ubicación."
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Padding="4,4,4,8" Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WarehousesCountText" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Click="AddWarehouseButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Add" />
                                    <TextBlock Text="Agregar almacén" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid>
                            <ListView
                                x:Name="WarehousesList"
                                MaxHeight="252"
                                SelectionMode="None"
                                IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <SymbolIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Symbol="Folder" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Location}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Tag="{Binding}" Click="EditItem_Click" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Editar">
                                                    <SymbolIcon Symbol="Edit" />
                                                </Button>
                                                <Button Tag="{Binding}" Click="DeleteItem_Click" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Eliminar">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="WarehousesEmptyText"
                                Text="No hay almacenes. Agrega el primero."
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed"
                                Margin="8,8" />
                        </Grid>
                    </StackPanel>
</Expander>

                <Expander
                    x:Name="LocationExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Padding="16,6,16,6"
                    Margin="0,2,0,10"
                    Expanding="CatalogExpander_Expanding"
                    Collapsed="CatalogExpander_Collapsed">
                    <Expander.Header>
                        <Grid ColumnSpacing="6" MinHeight="88">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="8">
                                <SymbolIcon Symbol="Map" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Ubicaciones de almacén" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Gestiona las ubicaciones, racks, pasillos o zonas dentro de los almacenes."
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Padding="4,4,4,8" Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LocationsCountText" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Click="AddLocationButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Add" />
                                    <TextBlock Text="Agregar ubicación" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid>
                            <ListView
                                x:Name="LocationsList"
                                MaxHeight="252"
                                SelectionMode="None"
                                IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <SymbolIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Symbol="Map" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Tag="{Binding}" Click="EditItem_Click" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Editar">
                                                    <SymbolIcon Symbol="Edit" />
                                                </Button>
                                                <Button Tag="{Binding}" Click="DeleteItem_Click" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Eliminar">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="LocationsEmptyText"
                                Text="No hay ubicaciones. Agrega la primera."
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed"
                                Margin="8,8" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ============ EMPRESA ============ -->
                <TextBlock x:Name="CompanySectionHeader" Text="Empresa" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,2,0,0" />

                <Expander
                    x:Name="CompanyExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Padding="16,6,16,6"
                    Margin="0,2,0,10"
                    Expanding="CatalogExpander_Expanding"
                    Collapsed="CatalogExpander_Collapsed">
                    <Expander.Header>
                        <Grid ColumnSpacing="6" MinHeight="88">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE821;" FontSize="26" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Datos de la empresa" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Nombre, dirección, ITBIS, logo y ubicación de la compañía para documentos y reportes."
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Padding="4,4,4,8" Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="420" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border
                                        Width="96"
                                        Height="96"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        VerticalAlignment="Center">
                                        <Image
                                            x:Name="CompanyLogoEdit"
                                            Stretch="Uniform"
                                            Margin="8" />
                                    </Border>
                                    <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Button
                                            Click="ChangeLogo_Click"
                                            Padding="10,6"
                                            HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE722;" FontSize="14" />
                                                <TextBlock Text="Cambiar logo" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock
                                            Text="Recomendado: PNG con fondo transparente."
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="180" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBox x:Name="CompanyNameBox" Header="Nombre de la empresa" />
                                <TextBox x:Name="CompanyAddressBox" Header="Dirección" AcceptsReturn="True" TextWrapping="Wrap" Height="64" />
                                <TextBox x:Name="CompanyItbisBox" Header="ITBIS / RNC" />
                                <Button
                                    Click="SaveCompany_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74E;" FontSize="14" />
                                        <TextBlock Text="Guardar cambios" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Height="320"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid x:Name="CompanyMapHost" SizeChanged="CompanyMapHost_SizeChanged">
                                    <Canvas x:Name="CompanyMapCanvas" />
                                    <FontIcon
                                        FontFamily="Segoe MDL2 Assets"
                                        Glyph="&#xE707;"
                                        FontSize="30"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                                    <Border
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Padding="10,6"
                                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <TextBlock
                                            Text="Ubicación de demostración — Av. Churchill, Santo Domingo"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>