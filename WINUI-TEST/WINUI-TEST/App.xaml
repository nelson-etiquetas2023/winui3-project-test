<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WINUI_TEST.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WINUI_TEST">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="CardBackgroundBrush">White</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryForegroundBrush">Black</SolidColorBrush>
            <SolidColorBrush x:Key="CardBackgroundBrushDark">#2D2D2D</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryForegroundBrushDark">White</SolidColorBrush>
            <SolidColorBrush x:Key="CardBackgroundBrushHighContrast">#000000</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryForegroundBrushHighContrast">#FFFFFF</SolidColorBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>