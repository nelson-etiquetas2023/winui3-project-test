<Window
    x:Class="WINUI_TEST.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WINUI_TEST"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="WINUI-TEST">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!-- Botones grandes de la barra de herramientas principal -->
            <Style x:Key="ToolbarAppBarButtonStyle" TargetType="AppBarButton">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="MinHeight" Value="96" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="AppBarButton">
                            <Grid
                                x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <StackPanel Spacing="4">
                                    <ContentPresenter
                                        Content="{TemplateBinding Icon}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{TemplateBinding Label}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de herramientas principal (global: anclada arriba, abarca navegación y páginas) -->
        <Border
            Grid.Row="0"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <Button
                    Click="CompanyLogo_Click"
                    ToolTipService.ToolTip="Cambiar logo de la empresa"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="10,6"
                    CornerRadius="8"
                    VerticalAlignment="Center">
                    <Image
                        x:Name="CompanyLogo"
                        Width="56"
                        Height="56"
                        Stretch="Uniform" />
                </Button>
                <StackPanel
                    x:Name="MainToolbar"
                    Orientation="Horizontal"
                    VerticalAlignment="Top">
                <AppBarButton
                    Style="{StaticResource ToolbarAppBarButtonStyle}"
Label="Órdenes de compra"
                        Tag="NavOrdenesCompra"
                        ToolTipService.ToolTip="Crea y gestiona las órdenes de compra a proveedores."
                        Click="ToolbarNav_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7BF;" FontSize="30" />
                    </AppBarButton.Icon>
                </AppBarButton>
<AppBarButton
                        Style="{StaticResource ToolbarAppBarButtonStyle}"
                        Label="Pedidos"
                        Tag="NavPedidos"
                        ToolTipService.ToolTip="Administra los pedidos y ventas de los clientes."
                        Click="ToolbarNav_Click">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" FontSize="30" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        Style="{StaticResource ToolbarAppBarButtonStyle}"
                        Label="Producción"
                        Tag="NavProduccion"
                        ToolTipService.ToolTip="Gestiona la producción y los procesos de fabricación."
                        Click="ToolbarNav_Click">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8F1;" FontSize="30" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        Style="{StaticResource ToolbarAppBarButtonStyle}"
                        Label="Productos"
                        Tag="NavProductos"
                        ToolTipService.ToolTip="Gestiona el catálogo de productos, precios y stock."
                        Click="ToolbarNav_Click">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7B8;" FontSize="30" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        Style="{StaticResource ToolbarAppBarButtonStyle}"
                        Label="Inventario"
                        Tag="NavInventario"
                        ToolTipService.ToolTip="Consulta y controla el inventario y sus ubicaciones."
                        Click="ToolbarNav_Click">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F8;" FontSize="30" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        Style="{StaticResource ToolbarAppBarButtonStyle}"
                        Label="Despacho"
                        Tag="NavDespacho"
                        ToolTipService.ToolTip="Prepara y gestiona el despacho de pedidos."
                        Click="ToolbarNav_Click">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72A;" FontSize="30" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                <AppBarButton
                    Style="{StaticResource ToolbarAppBarButtonStyle}"
Label="Configuración"
                        Tag="NavSettings"
                        ToolTipService.ToolTip="Configura los datos maestros y de la empresa."
                        Click="ToolbarNav_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="30" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Style="{StaticResource ToolbarAppBarButtonStyle}"
Label="Usuarios"
                        Tag="NavUsuarios"
                        ToolTipService.ToolTip="Administra los usuarios y permisos del sistema."
                        Click="ToolbarNav_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE716;" FontSize="30" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Style="{StaticResource ToolbarAppBarButtonStyle}"
Label="Clientes"
                        Tag="NavClientes"
                        ToolTipService.ToolTip="Gestiona la cartera de clientes y sus datos."
                        Click="ToolbarNav_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;" FontSize="30" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Style="{StaticResource ToolbarAppBarButtonStyle}"
Label="Proveedores"
                        Tag="NavProveedores"
                        ToolTipService.ToolTip="Gestiona los proveedores y sus datos."
                        Click="ToolbarNav_Click">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E3;" FontSize="30" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </StackPanel>
            </StackPanel>
        </Border>

        <NavigationView x:Name="NavView" Grid.Row="1" Loaded="NavView_Loaded" SelectionChanged="NavView_SelectionChanged" DisplayModeChanged="NavView_DisplayModeChanged" IsSettingsVisible="True">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="UserAreaBackground" Color="#FFDFDFDF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="UserAreaBackground" Color="#FF2A2A2A" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <StackPanel Spacing="10" Margin="0,10,0,6">
                    <TextBlock
                        x:Name="CompanyPaneName"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        FontWeight="Bold"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="2" />
                    <AutoSuggestBox
                        x:Name="ModuleSearch"
                        PlaceholderText="Buscar opción..."
                        Margin="0"
                        TextChanged="ModuleSearch_TextChanged">
                        <AutoSuggestBox.QueryIcon>
                            <SymbolIcon Symbol="Find" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <!-- Dashboard (default) -->
                <NavigationViewItem x:Name="NavDashboard" Content="Dashboard" Icon="Home">
                </NavigationViewItem>

                <!-- Main production item -->
                <NavigationViewItem x:Name="NavProduccion" Content="Producción" Icon="Library">
                </NavigationViewItem>

                <!-- Inventario item -->
                <NavigationViewItem x:Name="NavInventario" Content="Inventario" Icon="ViewAll">
                </NavigationViewItem>

                <!-- Productos top-level -->
                <NavigationViewItem x:Name="NavProductos" Content="Productos" Icon="Add">
                </NavigationViewItem>

                <!-- Usuarios top-level -->
                <NavigationViewItem x:Name="NavUsuarios" Content="Usuarios" Icon="People">
                </NavigationViewItem>

                <!-- VENTAS groups Clientes and Pedidos -->
                <NavigationViewItem x:Name="NavVentas" Content="Ventas" Icon="Shop" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Name="NavClientes" Content="Clientes" Icon="Contact" />
                        <NavigationViewItem x:Name="NavPedidos" Content="Pedidos" Icon="Memo" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- COMPRAS groups Proveedores and Órdenes de compra -->
                <NavigationViewItem x:Name="NavCompras" Content="Compras" Icon="Import" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Name="NavProveedores" Content="Proveedores" Icon="Manage" />
                        <NavigationViewItem x:Name="NavOrdenesCompra" Content="Órdenes de Compra" Icon="Document" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <!-- Despacho top-level -->
                <NavigationViewItem x:Name="NavDespacho" Content="Despacho" Icon="Forward">
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <TextBlock
                    x:Name="WelcomeText"
                    Text="Selecciona un módulo para empezar"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                <TabView
                    x:Name="MainTabs"
                    Visibility="Collapsed"
                    IsAddTabButtonVisible="False"
                    SelectionChanged="MainTabs_SelectionChanged"
                    TabCloseRequested="MainTabs_TabCloseRequested" />
            </Grid>

            <NavigationView.PaneFooter>
                <StackPanel>
                    <DropDownButton
                        x:Name="UserButton"
                        Margin="4,4,4,8"
                        Padding="8,4,8,4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource UserAreaBackground}"
                        BorderThickness="0"
                        CornerRadius="8">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="FlyoutLogin" Text="Iniciar sesión" Click="LoginMenuItem_Click" />
                                <MenuFlyoutItem x:Name="FlyoutCreate" Text="Crear cuenta" Click="CreateAccountMenuItem_Click" />
                                <MenuFlyoutItem x:Name="FlyoutLogout" Text="Cerrar sesión" Click="LogoutMenuItem_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture x:Name="UserAvatar" Width="36" Height="36" />
                            <StackPanel x:Name="UserTexts" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText" Text="Iniciar sesión" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="UserEmailText" Text="Sin sesión activa" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DropDownButton>
                    <ToggleSwitch
                        x:Name="ThemeSwitch"
                        Header="Cambiar tema"
                        Margin="12,0,12,4"
                        OnContent=""
                        OffContent=""
                        Toggled="ThemeSwitch_Toggled" />
                    <TextBlock Text="WINUI-TEST  •  Versión 1.0" Style="{ThemeResource CaptionTextBlockStyle}" Margin="12,0,12,0" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.Header>
                <StackPanel>
                    <Border
                        x:Name="GlobalCrumbBar"
                        Visibility="Collapsed"
                        Padding="16,8,16,0">
                        <BreadcrumbBar
                            x:Name="GlobalBreadcrumb"
                            AutomationProperties.Name="Ruta de navegación"
                            ItemClicked="GlobalBreadcrumb_ItemClicked" />
                    </Border>
                    <Grid Padding="0,4,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="HeaderTitleText"
                            Text="WINUI-TEST"
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Button
                            x:Name="TabsMoreButton"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Acciones de pestañas"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Cerrar todas las pestañas" Click="CloseAllTabs_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <SymbolIcon Symbol="More" />
                        </Button>
                    </Grid>
                </StackPanel>
            </NavigationView.Header>
        </NavigationView>
    </Grid>
</Window>